# Copy to .env for local Docker Compose runs. On Vercel, set these as project
# environment variables instead — never commit a filled-in .env.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=false
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=UTC

# Comma-separated. On Vercel, VERCEL_URL is added automatically once system
# environment variables are enabled, so this is only needed for a custom domain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# TLS is terminated by Vercel's edge. Leave the redirect on in production;
# turn it off for local HTTP runs.
DJANGO_SECURE_SSL_REDIRECT=false

# Database. Vercel does not host one, so this must point at an externally
# reachable managed database (Vercel Postgres/Neon, PlanetScale, a MySQL host,
# etc). A private hostname is not reachable from a Vercel container.
DATABASE_URL=mysql://root:devpassword@db:3306/railway

# Gunicorn sizing
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Optional one-shot admin bootstrap (all three required to take effect).
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=
