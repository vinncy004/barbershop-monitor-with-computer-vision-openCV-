# Copy to .env for local Docker Compose runs. On Railway, set these as service
# variables instead — never commit a filled-in .env.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=false
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=UTC

# Comma-separated. On Railway, RAILWAY_PUBLIC_DOMAIN is added automatically,
# so this is only needed for a custom domain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# TLS is terminated by Railway's edge. Leave the redirect on in production;
# turn it off for local HTTP runs.
DJANGO_SECURE_SSL_REDIRECT=false

# Database. On Railway, reference the database service instead of hardcoding:
#   DATABASE_URL = ${{ MySQL.MYSQL_URL }}      (MySQL plugin)
#   DATABASE_URL = ${{ Postgres.DATABASE_URL }} (Postgres plugin)
DATABASE_URL=mysql://root:devpassword@db:3306/railway

# Gunicorn sizing
WEB_CONCURRENCY=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Optional one-shot admin bootstrap (all three required to take effect).
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=
